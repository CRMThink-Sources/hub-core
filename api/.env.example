NODE_ENV=development
LOG_LEVEL=info
# Leitura do Loki pela aba Logs. Prod/staging: http://host.docker.internal:3100
LOKI_QUERY_URL=http://localhost:3100

APP_URL=http://localhost
API_URL=http://localhost:4001
# URL publica do front — retorno de checkout, portal de faturamento e OAuth.
# Opcional: sem ela, APP_URL e usada (front e api no mesmo host, /api/* para a api).
# Defina apenas se front e api estiverem em hosts diferentes.
FRONT_URL=
PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=db
DATABASE_URL=mysql://root:root@localhost:3306/db

REDIS_URL=redis://127.0.0.1:6379
# Prefixo das chaves do BullMQ — o que isola as filas de um ambiente das do outro.
# Ambientes que dividem o mesmo Redis e DB **sem** isso dividem a mesma fila: o worker
# de staging consome a mensagem de um cliente e a derruba contra o banco de homologação,
# e um envio de teste em staging pode ser entregue pelo worker de produção.
# Vazio = `bull`, o default do BullMQ. Trocar o valor TROCA DE FILA: o que estiver
# enfileirado no prefixo antigo fica órfão, então só com fila drenada.
# Produção fica sem setar (segue em `bull`); staging usa `bull-staging`.
# Isola só o BullMQ — cache de botId e locks não têm prefixo, então mantenha índices de
# DB distintos no REDIS_URL (`/0` produção, `/1` staging).
QUEUE_PREFIX=
BULL_BOARD_ENABLED=true
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123

CRMTHINK_WEBHOOK_URL=webhook_crmthink

# Application token do webhook de saída das SPAs de billing (portal interno), o
# valor que aparece na tela do webhook em "Aplicações > Webhooks de saída". É o
# único fator de autenticação de POST /api/webhooks/spa — o Bitrix não assina o
# corpo do webhook de saída.
#
# Vazio = rota responde 503 e nada é invalidado. Sem isso, qualquer um poderia
# esvaziar o cache do módulo payments.
#
# A rota faz mais que invalidar: a **criação** de item na SPA 1146 enfileira o
# provisionamento do conector dele (instância Z-API ou canal HubMessage) e o ajuste
# da cobrança no gateway. Quem consome a fila é o worker
# `dist/src/workers/spa-item-provisioning.worker.js` (`yarn worker:spa-provisioning`
# em dev) — sem ele rodando, item criado à mão no CRM fica pendente na fila.
BITRIX_SPA_WEBHOOK_TOKEN=
# Efeitos de provider dos eventos das SPAs 1146/1142 (provisionar, assinar, desassinar,
# limpar). Ausente = ligado. Homologação seta `false`: o portal é o mesmo de produção, e
# os dois ambientes recebem os mesmos eventos. O webhook segue invalidando cache.
THINKZAP_SPA_PROVIDER_EFFECTS_ENABLED=true
# Verificação de assinaturas (job horário) da SPA 1142: "Em teste" vencido vira
# "Teste expirado"; manual "Ativo" vencido vira "Vencido" (com "Vencido em"); manual
# "Vencido" tem as linhas desassinadas no 5º dia e é cancelada no 10º; uma vez por dia
# reconcilia (subscribe) as linhas ativas. Ausente = segue
# THINKZAP_SPA_PROVIDER_EFFECTS_ENABLED (desligado em homologação). As etapas que chamam
# o provider só rodam com THINKZAP_SPA_PROVIDER_EFFECTS_ENABLED ligado.
# Em desenvolvimento local, deixe as duas em false: o CRM e os providers são os reais.
SUBSCRIPTION_EXPIRATION_ENABLED=
# Dias de tolerância depois do fim do período antes de a assinatura manual virar
# "Vencido". Inteiro >= 0; ausente ou inválido = 0. Não vale para o trial.
MANUAL_SUBSCRIPTION_GRACE_DAYS=0
# Hora local (0-23) a partir da qual a rodada agendada inclui a reconciliação diária das
# linhas, e o fuso dessa hora. Ausente = 3 e America/Sao_Paulo.
SUBSCRIPTION_RECONCILE_HOUR=3
SUBSCRIPTION_RECONCILE_TIMEZONE=America/Sao_Paulo
# Sincronização Stripe → SPA 1142 (job horário no minuto 30): aplica status e período
# das assinaturas Stripe como o webhook; cancelada no Stripe cancela e desassina as linhas.
# Ausente = ligado só com THINKZAP_SPA_PROVIDER_EFFECTS_ENABLED ligado e chave Stripe live.
# Em desenvolvimento local, deixe false.
STRIPE_SYNC_ENABLED=

JWT_SECRET=jwt_secret

# Portal admin bootstrap (optional — used by create-portal-user script)
PORTAL_BOOTSTRAP_EMAIL=
PORTAL_BOOTSTRAP_NAME=Admin
PORTAL_BOOTSTRAP_PASSWORD=

Z_API_PARTNER_TOKEN=partner_token
Z_API_CLIENT_TOKEN=client_token

Z_API_CALLBACK_URL=http://localhost:4001/api/webhooks/z-api
THINKZAP_APP_CODE=thinkzap_app_code
# true/false - em dev pode usar true para não criar instâncias reais na Z-API
THINKZAP_MOCK_ZAPI_PROVISIONING=true
# Id do item de plano na SPA de planos (1138) que as assinaturas de trial referenciam.
# Vazio, ou apontando para item inexistente, deixa o trial indisponivel: a rota
# GET /thinkzap/trial responde `misconfigured` em vez de falhar na hidratacao do plano.
THINKZAP_TRIAL_PLAN_ID=

# Stripe. Vazio = contratação self-service indisponível (sem checkout e sem portal
# de faturamento). A modalidade boleto NÃO depende disto: ela é criada na SPA por
# automação externa, e o runtime lê a SPA.
#
# STRIPE_WEBHOOK_SECRET valida a assinatura do evento sobre o corpo cru. Sem ele o
# endpoint recusa todo evento — um `checkout.session.completed` forjado destravaria
# uma linha sem pagamento.
#
# O PREFIXO DA CHAVE DECIDE O AMBIENTE DO GATEWAY. `sk_live_`/`rk_live_` = produção;
# qualquer outro valor (incluindo vazio) = homologação. Não é NODE_ENV: produção e
# homologação usam o MESMO portal Bitrix, logo a mesma SPA de planos (1138), e o que
# as separa é a conta Stripe. O ambiente escolhe qual campo de price id do plano o
# runtime lê:
#   producao   -> UF_CRM_89_GATEWAY_ID          (ufCrm89GatewayId)
#   homologacao-> UF_CRM_89_GATEWAY_ID_HOMOLOG  (ufCrm89GatewayIdHomolog)
# Não há fallback entre os dois: price id preenchido só no outro ambiente deixa o
# plano NÃO ofertável, com aviso no log nomeando o campo vazio. É de propósito —
# "é trial" é derivado de o plano não ter price id, e o fallback cobraria a conta
# errada ou liberaria linha paga de graça.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# HubMessage (WhatsApp Oficial). Sem HUBMESSAGE_SECRET_KEY o provider HubMessage
# não é registrado (só Z-API funciona). Base default: https://api.hubmessage.io
HUBMESSAGE_PUBLIC_KEY=public_key
HUBMESSAGE_SECRET_KEY=secret_key
HUBMESSAGE_BASE_URL=https://api.hubmessage.io
# URL pública que recebe os eventos do canal (webhook MESSAGE_RECEIVED)
HUBMESSAGE_WEBHOOK_URL=https://app.suaempresa.com/webhooks/hubmessage

# Cloudflare R2: imagem do cabeçalho enviada como arquivo pelo widget. Sem as cinco
# variáveis o upload fica desligado (o widget mostra só o campo de link). O bucket
# precisa de acesso público e de regra de ciclo de vida apagando em 30 dias.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=thinkzap-template-images-staging
# R2_PUBLIC_BASE_URL=https://imagens.suaempresa.com.br

# Cloudflare R2: anexos que esperam a vez na fila de saída (cadenciador). Bucket
# PRIVADO, separado do de cima e sem domínio público nem r2.dev: no R2 o acesso
# público vale para o bucket inteiro. Mesma conta e chaves acima. Regra de ciclo de
# vida apagando em 30 dias. Vazio = o envio com anexo e o robô seguem síncronos.
# R2_OUTBOUND_MEDIA_BUCKET=thinkzap-outbound-media-staging

# Widget IM_TEXTAREA (placement.bind HANDLER) — URL publica do FRONT, path /bitrix/widget/audio
# Local: http://localhost:3000/bitrix/widget/audio (so abre no seu browser; Bitrix cloud exige HTTPS + tunel)
# Dev + Bitrix cloud: cloudflared tunnel --url http://localhost:3000 (ver docs/DEV-BITRIX.md)
# Nao use ngrok free (*.ngrok-free.dev) no iframe — chunks /_next retornam HTML e geram Unexpected token '<'
# BITRIX_IFRAME_AUDIO_URL=https://SEU-TUNEL.trycloudflare.com/bitrix/widget/audio
BITRIX_IFRAME_AUDIO_CODE=thinkzap_audio_code
BITRIX_IFRAME_AUDIO_NAME=ThinkZap Audio Name
BITRIX_IFRAME_AUDIO_URL=http://localhost:3000/bitrix/widget/audio
BITRIX_IFRAME_AUDIO_HASH=iframe_audio_hash

# Mesmo esquema do widget de áudio acima, outro ícone na barra do canal aberto —
# a tela de envio de botões. Reaproveita BITRIX_IFRAME_AUDIO_HASH (é o segredo
# nosso de validação do iframe imbot, não algo específico do áudio).
BITRIX_IFRAME_BUTTON_CODE=thinkzap_button_code
BITRIX_IFRAME_BUTTON_NAME=ThinkZap Botões
BITRIX_IFRAME_BUTTON_URL=http://localhost:3000/bitrix/widget/button

# Local dev only: set to false if TLS fails (proxy/antivirus SSL inspection). Never use in production.
# BITRIX_TLS_REJECT_UNAUTHORIZED=false

# Webhook na API. Com proxy /api no next dev, pode usar o MESMO host do tunel do front:
# BITRIX_WEBHOOK_URL=https://SEU-TUNEL.trycloudflare.com/api/webhooks/bitrix
BITRIX_WEBHOOK_URL=http://localhost:4001/api/webhooks/bitrix

# `code` do bot do ThinkBot no portal. Único NO PORTAL, não por app: dois ambientes nossos
# no mesmo Bitrix24 disputam o mesmo nome e o segundo a vincular leva BOT_CODE_ALREADY_TAKEN,
# porque `imbot.v2.Bot.register` só é idempotente para o app que registrou o bot.
# Produção usa o default `thinkzap-flow`; sufixe por ambiente aqui.
BITRIX_BOT_FLOW_CODE=thinkzap-flow-dev

BITRIX_CONNECTOR_CODE=hubthink_thinkzap_code
BITRIX_CONNECTOR_NAME="ThinkZap Name"
BITRIX_CONNECTOR_URL=http://localhost:3000/thinkzap/connector
# Título das abas do widget de conversas — CRM (contact/company/deal/lead) e SPAs. Vazio = ThinkZap
# Valor é por deploy, não por portal: todos os portais desta instância recebem o mesmo título
# Sufixe por ambiente para saber qual backend está atrás da aba: "ThinkZap Dev", "ThinkZap Homolog"
# Trocar aqui NÃO renomeia portais já instalados: re-registre em portal admin > Registrar widget
# e chame POST /spa-placements/sync para as abas de SPA
BITRIX_PLACEMENT_NAME=ThinkZap
BITRIX_PLACEMENT_URL=http://localhost:3000/widgets/conversations

# Robô de Bizproc de envio de TEMPLATE aprovado (WhatsApp Oficial), separado do robô
# de envio livre. Sem HANDLER_URL o robô NÃO é registrado no portal — é assim que um
# ambiente sem a rota publicada evita automação apontando para 404.
# Sem PLACEMENT_URL o robô é registrado SEM a tela própria: o Bitrix cai no formulário
# nativo sobre as mesmas propriedades (configurável, só sem lista de templates).
# O HANDLER_URL tem que bater com a rota do webhook: <API>/api/thinkzap/webhooks/bitrix/template-robot
BITRIX_TEMPLATE_ROBOT_CODE=thinkzap_template_robot
BITRIX_TEMPLATE_ROBOT_NAME="ThinkZap - Enviar template (WhatsApp Oficial)"
BITRIX_TEMPLATE_ROBOT_HANDLER_URL=http://localhost:4001/api/thinkzap/webhooks/bitrix/template-robot
BITRIX_TEMPLATE_ROBOT_PLACEMENT_URL=http://localhost:3000/bitrix/bizproc/template

# Dois robôs de Bizproc de envio de mensagem com BOTÕES, um por provider — oficial
# (WhatsApp Oficial/HubMessage, botões URL/CALL) e não oficial (Z-API, botões
# REPLY/URL/CALL). Mesma regra de HANDLER_URL/PLACEMENT_URL vazio do robô de template.
# NAME fica em env de propósito: a copy que aparece na lista de robôs do Bitrix ainda
# não foi validada com o time.
BITRIX_BUTTON_ROBOT_OFFICIAL_CODE=thinkzap_button_robot_official
BITRIX_BUTTON_ROBOT_OFFICIAL_NAME="ThinkZap - Enviar botões (WhatsApp Oficial)"
BITRIX_BUTTON_ROBOT_OFFICIAL_HANDLER_URL=http://localhost:4001/api/thinkzap/webhooks/bitrix/button-robot-official
BITRIX_BUTTON_ROBOT_OFFICIAL_PLACEMENT_URL=http://localhost:3000/bitrix/bizproc/button-official

BITRIX_BUTTON_ROBOT_UNOFFICIAL_CODE=thinkzap_button_robot_unofficial
BITRIX_BUTTON_ROBOT_UNOFFICIAL_NAME="ThinkZap - Enviar botões (Z-API)"
BITRIX_BUTTON_ROBOT_UNOFFICIAL_HANDLER_URL=http://localhost:4001/api/thinkzap/webhooks/bitrix/button-robot-unofficial
BITRIX_BUTTON_ROBOT_UNOFFICIAL_PLACEMENT_URL=http://localhost:3000/bitrix/bizproc/button-unofficial

# Provedor de mensagem da campanha de SMS do Bitrix (messageservice), um por linha.
# CODE_PREFIX monta o CODE do sender com o id do item de assinatura da linha
# (<prefixo>_<subscriptionItemId>) — é o único identificador que volta no payload do
# handler, e é por ele que a campanha reencontra a linha.
# Sem HANDLER_URL o registro vira no-op (resultado `skipped`, nenhuma chamada ao
# Bitrix) — é assim que um ambiente sem a rota publicada evita registrar no portal do
# cliente um provedor apontando para 404.
# O HANDLER_URL tem que bater com a rota do webhook: <API>/api/thinkzap/webhooks/bitrix/sms-provider
# Exige o escopo `messageservice` no manifesto do app no Marketplace.
BITRIX_SMS_SENDER_CODE_PREFIX=thinkzap_sms
BITRIX_SMS_HANDLER_URL=http://localhost:4001/api/thinkzap/webhooks/bitrix/sms-provider

CONTA_AZUL_CLIENT_ID=5jr5rkrj7crtuppnd4ni7mvpd7
CONTA_AZUL_CLIENT_SECRET=16clrmecciqrppgbgd6p7foo8181591sem6c62ajv07jkv9lvke4
CONTA_AZUL_AUTH_URL=https://auth.contaazul.com/oauth2/authorize
CONTA_AZUL_TOKEN_URL=https://auth.contaazul.com/oauth2/token
CONTA_AZUL_API_URL=https://api-v2.contaazul.com/v1

OMIE_API_URL=https://app.omie.com.br/api/v1

BLING_CLIENT_ID=bling_client_id
BLING_CLIENT_SECRET=bling_client_secret
BLING_AUTH_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://www.bling.com.br/Api/v3/oauth/token
BLING_API_URL=https://api.bling.com.br/Api/v3

# ImportSheet — Google OAuth (Drive/Sheets readonly)
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
IMPORTSHEET_APP_CODE=crmthink.importsheet

# Chave AES-256 (base64, 32 bytes) para cifrar tokens at-rest. Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# GPT Maker. Credencial COMPARTILHADA: todos os agentes de todos os clientes
# vivem neste workspace, porque a cobranca e por creditos. Nao ha token por
# instalacao — quem separa um cliente do outro e a tabela core_gpt_agents.
# Vazio derruba a criacao de agente (o resto da API sobe normalmente).
GPTMAKER_API_TOKEN=
GPTMAKER_WORKSPACE_ID=
GPTMAKER_BASE_URL=https://api.gptmaker.ai/v2

# Code da app publicada no marketplace do Bitrix. Em producao coincide com o
# canonico; em instalacao de teste o Bitrix devolve algo como local.<hash>.
GPTMAKER_APP_CODE=crmthink.gptmaker
