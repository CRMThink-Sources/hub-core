NODE_ENV=development
LOG_LEVEL=info
# Leitura do Loki pela aba Logs. Prod/staging: http://host.docker.internal:3100
LOKI_QUERY_URL=http://localhost:3100

APP_URL=http://localhost
API_URL=http://localhost:4001
FRONT_URL=http://localhost:3000
PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=db
DATABASE_URL=mysql://root:root@localhost:3306/db

REDIS_URL=redis://127.0.0.1:6379
BULL_BOARD_ENABLED=true
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123

STRIPE_SECRET_KEY=secret_key
CRMTHINK_WEBHOOK_URL=webhook_crmthink

STRIPE_WEBHOOK_SECRET=webhook_secret
JWT_SECRET=jwt_secret

# Portal admin bootstrap (optional — used by create-portal-user script)
PORTAL_BOOTSTRAP_EMAIL=
PORTAL_BOOTSTRAP_NAME=Admin
PORTAL_BOOTSTRAP_PASSWORD=

Z_API_PARTNER_TOKEN=partner_token
Z_API_CLIENT_TOKEN=client_token

Z_API_CALLBACK_URL=http://localhost:4001/api/webhooks/z-api
THINKZAP_APP_CODE=thinkzap_app_code
THINKZAP_PRICE_CONNECTORS=price
# true/false - em dev pode usar true para não criar instâncias reais na Z-API
THINKZAP_MOCK_ZAPI_PROVISIONING=true

# HubMessage (WhatsApp Oficial). Sem HUBMESSAGE_SECRET_KEY o provider HubMessage
# não é registrado (só Z-API funciona). Base default: https://api.hubmessage.io
HUBMESSAGE_PUBLIC_KEY=public_key
HUBMESSAGE_SECRET_KEY=secret_key
HUBMESSAGE_BASE_URL=https://api.hubmessage.io
# URL pública que recebe os eventos do canal (webhook MESSAGE_RECEIVED)
HUBMESSAGE_WEBHOOK_URL=https://app.suaempresa.com/webhooks/hubmessage
# Price ID do produto de conectores HubMessage no Stripe
HUBMESSAGE_PRICE_CONNECTORS=price

# Widget IM_TEXTAREA (placement.bind HANDLER) — URL publica do FRONT, path /bitrix/widget/audio
# Local: http://localhost:3000/bitrix/widget/audio (so abre no seu browser; Bitrix cloud exige HTTPS + tunel)
# Dev + Bitrix cloud: cloudflared tunnel --url http://localhost:3000 (ver docs/DEV-BITRIX.md)
# Nao use ngrok free (*.ngrok-free.dev) no iframe — chunks /_next retornam HTML e geram Unexpected token '<'
# BITRIX_IFRAME_AUDIO_URL=https://SEU-TUNEL.trycloudflare.com/bitrix/widget/audio
BITRIX_IFRAME_AUDIO_CODE=thinkzap_audio_code
BITRIX_IFRAME_AUDIO_NAME=ThinkZap Audio Name
BITRIX_IFRAME_AUDIO_URL=http://localhost:3000/bitrix/widget/audio
BITRIX_IFRAME_AUDIO_HASH=iframe_audio_hash

# Local dev only: set to false if TLS fails (proxy/antivirus SSL inspection). Never use in production.
# BITRIX_TLS_REJECT_UNAUTHORIZED=false

# Webhook na API. Com proxy /api no next dev, pode usar o MESMO host do tunel do front:
# BITRIX_WEBHOOK_URL=https://SEU-TUNEL.trycloudflare.com/api/webhooks/bitrix
BITRIX_WEBHOOK_URL=http://localhost:4001/api/webhooks/bitrix

BITRIX_CONNECTOR_CODE=hubthink_thinkzap_code
BITRIX_CONNECTOR_NAME="ThinkZap Name"
BITRIX_CONNECTOR_URL=http://localhost:3000/thinkzap/connector
BITRIX_PLACEMENT_URL=http://localhost:3000/widgets/conversations

CONTA_AZUL_CLIENT_ID=5jr5rkrj7crtuppnd4ni7mvpd7
CONTA_AZUL_CLIENT_SECRET=16clrmecciqrppgbgd6p7foo8181591sem6c62ajv07jkv9lvke4
CONTA_AZUL_AUTH_URL=https://auth.contaazul.com/oauth2/authorize
CONTA_AZUL_TOKEN_URL=https://auth.contaazul.com/oauth2/token
CONTA_AZUL_API_URL=https://api-v2.contaazul.com/v1

OMIE_API_URL=https://app.omie.com.br/api/v1

BLING_CLIENT_ID=bling_client_id
BLING_CLIENT_SECRET=bling_client_secret
BLING_AUTH_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://www.bling.com.br/Api/v3/oauth/token
BLING_API_URL=https://api.bling.com.br/Api/v3

# ImportSheet — Google OAuth (Drive/Sheets readonly)
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
IMPORTSHEET_APP_CODE=crmthink.importsheet

# Chave AES-256 (base64, 32 bytes) para cifrar tokens at-rest. Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
