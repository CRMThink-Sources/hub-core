generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Domain {
  id        String   @id @default(uuid())
  name      String   @unique
  memberId  String   @unique @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apps      App[]
  instances Instance[]

  @@map("core_domains")
}

model AppCode {
  id          String        @id @default(uuid())
  code        String        @unique @map("code")
  name        String
  secret      String        @map("secret")
  description String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  apps        App[]
  plans       BillingPlan[]

  @@map("core_app_codes")
}

model App {
  id          String    @id @default(uuid())
  domainId    String    @map("domain_id")
  appCodeId   String    @map("app_code_id")
  email       String    @map("email")
  status      AppStatus @default(ACTIVE)
  installedAt DateTime  @default(now()) @map("installed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  domain              Domain                @relation(fields: [domainId], references: [id])
  appCode             AppCode               @relation(fields: [appCodeId], references: [id])
  credential          Credential?
  balance             BillingBalance?
  agents              Agent[]
  connectors          Connector[]
  biAnalyseConnectors   BiAnalyseConnector[]
  thinkAnaliseAuthTokens ThinkAnaliseAuthToken[]
  subscriptions       BillingSubscription[]
  thinkzapAllowedUsers       ThinkzapAllowedUser[]
  thinkzapAllowedDepartments ThinkzapAllowedDepartment[]

  @@unique([domainId, appCodeId])
  @@index([domainId])
  @@index([appCodeId])
  @@map("core_apps")
}

model Credential {
  id           String   @id @default(uuid())
  appId        String   @unique @map("app_id")
  clientId     String   @map("client_id")
  clientSecret String   @map("client_secret")
  accessToken  String?  @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@map("core_credentials")
}

// ============================================
// BILLING - Créditos (GPT Maker) / Assinatura (ThinkersZap)
// ============================================

/// Saldo de créditos — usado por apps com plano tipo CREDITS (ex: GPT Maker).
model BillingBalance {
  id             Int      @id @default(autoincrement())
  appId          String   @unique @map("app_id")
  currentBalance Int      @default(0) @map("current_balance")
  totalPurchased Int      @default(0) @map("total_purchased")
  totalConsumed  Int      @default(0) @map("total_consumed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  app          App                  @relation(fields: [appId], references: [id])
  transactions BillingTransaction[]

  @@map("billing_balances")
}

model BillingTransaction {
  id           Int             @id @default(autoincrement())
  appId        String          @map("app_id")
  type         TransactionType
  amount       Int
  balanceAfter Int             @map("balance_after")
  description  String
  referenceId  String?         @map("reference_id")
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  balance BillingBalance @relation(fields: [appId], references: [appId])

  @@index([appId])
  @@index([type])
  @@index([createdAt])
  @@map("billing_transactions")
}

/// Planos: CREDITS (pacotes de créditos, ex: GPT Maker) ou SUBSCRIPTION (valor fixo mensal, ex: ThinkersZap).
model BillingPlan {
  id           Int      @id @default(autoincrement())
  appCodeId    String   @map("app_code_id")
  type         PlanType @default(CREDITS)
  name         String
  description  String?  @db.Text
  /// Apenas para type CREDITS.
  credits      Int?
  bonusCredits Int?     @map("bonus_credits")
  price        Decimal  @db.Decimal(10, 2)

  isRecurring   Boolean  @default(false) @map("is_recurring")
  stripePriceId String?  @map("stripe_price_id")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  appCode       AppCode               @relation(fields: [appCodeId], references: [id])
  subscriptions BillingSubscription[]

  @@index([appCodeId])
  @@index([type])
  @@map("billing_plans")
}

/// Assinatura mensal — vínculo entre App e Stripe. Detalhes de período/cancelamento ficam no Stripe.
model BillingSubscription {
  id                   String             @id @default(uuid())
  appId                String             @map("app_id")
  planId               Int?               @map("plan_id") // opcional (GPT Maker pode ter plano, ThinkersZap não)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  connectorQuantity    Int                @default(0) @map("connector_quantity")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  app  App          @relation(fields: [appId], references: [id])
  plan BillingPlan? @relation(fields: [planId], references: [id])

  @@index([appId])
  @@index([status])
  @@map("billing_subscriptions")
}

// ============================================
// GPT MAKER
// ============================================
model Agent {
  id              String @id @default(uuid())
  appId           String @map("app_id")
  gptMakerAgentId String @unique @map("gpt_maker_agent_id")

  app App @relation(fields: [appId], references: [id])

  @@map("core_gpt_agents")
}

// ============================================
// ThinkersZap
// ============================================

model Connector {
  id         String          @id @default(uuid())
  appId      String          @map("app_id")
  instanceId String?         @unique @map("instance_id")
  status     ConnectorStatus @default(PENDING_SETUP)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  app      App       @relation(fields: [appId], references: [id])
  instance Instance? @relation(fields: [instanceId], references: [id])

  @@index([appId])
  @@map("core_thinkerszap_connectors")
}

model Instance {
  id                String         @id @default(uuid())
  domainId          String         @map("domain_id")
  instanceId        String         @unique @map("instance_id")
  vinculatedChannel String?        @map("vinculated_channel")
  zApiToken         String?        @map("z_api_token")
  status            InstanceStatus @default(DISCONNECTED)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  domain        Domain         @relation(fields: [domainId], references: [id])
  connector     Connector?
  conversations Conversation[]

  @@map("core_thinkerszap_instances")
}

model Conversation {
  id              String   @id @default(uuid())
  instanceId      String
  phoneNumber     String // Número do WhatsApp
  bitrixChatId    String // ID do chat no Bitrix
  bitrixChannelId String // ID do canal no Bitrix
  createdAt       DateTime
  updatedAt       DateTime

  instance Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, phoneNumber])
  @@index([instanceId])
  @@index([bitrixChatId])
  @@map("core_thinkerszap_conversations")
}

model ThinkzapAllowedUser {
  id           String   @id @default(uuid())
  appId        String   @map("app_id")
  bitrixUserId String   @map("bitrix_user_id")
  displayName  String?  @map("display_name")
  email        String?  @map("email")
  permissions  Json     @default("{\"connectors\":{\"read\":true,\"create\":true,\"update\":true,\"delete\":true},\"finance\":{\"read\":false,\"create\":false,\"update\":false,\"delete\":false}}")
  createdAt    DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixUserId])
  @@index([appId])
  @@map("thinkzap_allowed_users")
}

model ThinkzapAllowedDepartment {
  id                   String   @id @default(uuid())
  appId                String   @map("app_id")
  bitrixDepartmentId   String   @map("bitrix_department_id")
  displayName          String?  @map("display_name")
  permissions          Json     @default("{\"connectors\":{\"read\":true,\"create\":true,\"update\":true,\"delete\":true},\"finance\":{\"read\":false,\"create\":false,\"update\":false,\"delete\":false}}")
  createdAt            DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixDepartmentId])
  @@index([appId])
  @@map("thinkzap_allowed_departments")
}

// ============================================
// ThinkAnalise
// ============================================

model BiAnalyseConnector {
  id            String            @id @default(uuid())
  appId         String            @map("app_id")
  biconnectorId Int               @map("biconnector_id")
  label         String
  provider      BiAnalyseProvider
  apiKey        String            @map("api_key") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@index([appId])
  @@map("core_thinkanalise_connectors")
}

model ThinkAnaliseAuthToken {
  id                   String    @id @default(uuid())
  appId                String    @map("app_id")
  provider             String
  tokenKey             String    @unique @default(uuid()) @map("token_key") @db.Char(36)
  bitrixSourceId       Int?      @unique @map("bitrix_source_id")
  accountId            String?   @map("account_id")
  refreshToken         String    @map("refresh_token") @db.Text
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.Char(64)
  accessToken          String?   @map("access_token") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@index([appId])
  @@map("core_thinkanalise_auth_tokens")
}

// ============================================
// ENUMS
// ============================================

enum AppStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

/// Tipo de plano: por créditos (GPT Maker) ou assinatura mensal fixa (ThinkersZap).
enum PlanType {
  CREDITS
  SUBSCRIPTION
}

enum TransactionType {
  PURCHASE
  CONSUMPTION
  BONUS
  REFUND
  EXPIRATION
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum ConnectorStatus {
  PENDING_SETUP
  ACTIVE
  INACTIVE
}

enum InstanceStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
}

enum BiAnalyseProvider {
  ASAAS
  CONTA_AZUL
  OMIE
  SONAX
}
