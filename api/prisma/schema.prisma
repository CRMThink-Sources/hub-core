generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Domain {
  id        String   @id @default(uuid())
  name      String   @unique
  memberId  String   @unique @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apps      App[]
  instances Instance[]
  mcpUsers  McpUser[]

  @@map("core_domains")
}

model AppCode {
  id          String   @id @default(uuid())
  code        String   @unique @map("code")
  name        String
  secret      String   @map("secret")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  apps        App[]

  @@map("core_app_codes")
}

model App {
  id          String    @id @default(uuid())
  domainId    String    @map("domain_id")
  appCodeId   String    @map("app_code_id")
  /// Id do item espelho desta instalacao na SPA 1060 do Bitrix.
  /// `null` = instalacao sem espelho (instalada antes do backfill, ou falha na
  /// criacao do item). Estado valido: so impede criar assinatura, que precisa
  /// do id da SPA no campo parent.
  spaId       String?   @unique @map("spa_id")
  email       String    @map("email")
  status      AppStatus @default(ACTIVE)
  /// Idioma escolhido no app (`pt` | `en` | `es`), por instalacao. E o que o
  /// servidor usa nos avisos que gera sem tela aberta (ex.: limite diario do
  /// ThinkZap). `null` = nunca escolhido; os avisos saem em portugues.
  locale      String?   @map("locale") @db.VarChar(5)
  installedAt DateTime  @default(now()) @map("installed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  domain                     Domain                      @relation(fields: [domainId], references: [id])
  appCode                    AppCode                     @relation(fields: [appCodeId], references: [id])
  credential                 Credential?
  balance                    BillingBalance?
  agents                     Agent[]
  connectors                 Connector[]
  biAnalyseConnectors        BiAnalyseConnector[]
  thinkAnaliseAuthTokens     ThinkAnaliseAuthToken[]
  thinkzapAllowedUsers       ThinkzapAllowedUser[]
  thinkzapConnectionNotifyRecipients ThinkzapConnectionNotifyRecipient[]
  thinkzapAllowedDepartments ThinkzapAllowedDepartment[]
  thinkzapOperatorOAuth      ThinkzapOperatorOAuth[]
  thinkzapBotFlows           ThinkzapBotFlow[]
  thinkzapBotFlowBots        ThinkzapBotFlowBot[]
  thinkzapBotFlowBindings    ThinkzapBotFlowBinding[]
  thinkzapBotSessions        ThinkzapBotSession[]
  importSheetAuthToken       ImportSheetAuthToken?
  importSheetImports         ImportSheetImport[]
  clickSignSettings          ClickSignSettings?

  @@unique([domainId, appCodeId])
  @@index([domainId])
  @@index([appCodeId])
  @@map("core_apps")
}

model Credential {
  id                    String   @id @default(uuid())
  appId                 String   @unique @map("app_id")
  clientId              String   @map("client_id")
  clientSecret          String   @map("client_secret")
  accessToken           String?  @map("access_token") @db.Text
  refreshToken          String   @map("refresh_token") @db.Text
  expiresAt             DateTime @map("expires_at")
  /// Falhas consecutivas de refresh. Zera em toda escrita bem-sucedida de tokens
  /// (refresh OK ou reautorização); ao chegar em MAX_REFRESH_ATTEMPTS
  /// (`refresh-expired-credentials.ts`), a credencial para de ser buscada.
  refreshFailedAttempts Int      @default(0) @map("refresh_failed_attempts")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@map("core_credentials")
}

// ============================================
// BILLING - Créditos (GPT Maker) / Assinatura (ThinkersZap)
// ============================================

/// Saldo de créditos — usado por apps com plano tipo CREDITS (ex: GPT Maker).
model BillingBalance {
  id             Int      @id @default(autoincrement())
  appId          String   @unique @map("app_id")
  currentBalance Int      @default(0) @map("current_balance")
  totalPurchased Int      @default(0) @map("total_purchased")
  totalConsumed  Int      @default(0) @map("total_consumed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  app          App                  @relation(fields: [appId], references: [id])
  transactions BillingTransaction[]

  @@map("billing_balances")
}

model BillingTransaction {
  id           Int             @id @default(autoincrement())
  appId        String          @map("app_id")
  type         TransactionType
  amount       Int
  balanceAfter Int             @map("balance_after")
  description  String
  referenceId  String?         @map("reference_id")
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  balance BillingBalance @relation(fields: [appId], references: [appId])

  @@index([appId])
  @@index([type])
  @@index([createdAt])
  @@map("billing_transactions")
}

// `BillingPlan` e `BillingSubscription` foram removidos junto com a cobrança
// antiga (Stripe + tela de financeiro). A cobrança nova será modelada do zero;
// enquanto isso não existe nenhuma fonte de estado de assinatura no banco.

// ============================================
// GPT MAKER
// ============================================
/// Agente do GPT Maker pertencente a uma instalacao.
///
/// Todos os agentes de todos os clientes vivem no MESMO workspace do vendor —
/// a cobranca e por creditos, nao pelo workspace do cliente. O vendor nao
/// conhece instalacao: um `gpt_maker_agent_id` do cliente A e aceito pela API
/// dele se enviado pelo cliente B. **Esta tabela e a unica fronteira entre
/// clientes**, e por isso todo acesso ao vendor passa por `forAgent`, que
/// resolve a posse aqui antes de qualquer chamada.
model Agent {
  id    String @id @default(uuid())
  appId String @map("app_id")

  /// Id do agente no vendor. Unique **global**, e nao por instalacao: como o
  /// workspace e compartilhado, este id e unico no mundo todo, e a restricao
  /// global e o que impede duas instalacoes reivindicarem o mesmo agente. Um
  /// unique composto com `app_id` deixaria exatamente esse caso passar.
  gptMakerAgentId String @unique @map("gpt_maker_agent_id")

  /// IMBOT do portal do cliente vinculado a este agente. `null` = agente sem
  /// bot, que nao recebe mensagem de canal aberto mas ja ocupa recurso no
  /// workspace compartilhado (e por isso conta para o teto de 5).
  botId Int? @map("bot_id")

  /// Espelho do nome no vendor, mantido so para montar a lista sem uma
  /// chamada ao vendor por agente. O valor de verdade e o do vendor.
  name String?

  /// Janela de atendimento. Regra nossa, aplicada antes de acionar o agente:
  /// nao existe no vendor.
  worktimeEnabled Boolean @default(false) @map("worktime_enabled")
  initHour        String? @map("init_hour") @db.Char(5)
  endHour         String? @map("end_hour") @db.Char(5)
  /// Dias da semana ativos, 0 (domingo) a 6.
  activeDays      Json?   @map("active_days")
  /// Identificador IANA (ex: `America/Sao_Paulo`). Nao e offset: offset erra
  /// durante horario de verao.
  timezone        String? @map("timezone")
  /// Inverte a janela: `true` = o agente atende FORA do expediente e silencia
  /// dentro dele. Era `activeOfHours` no HubThink, cujo nome dizia o oposto do
  /// que o codigo fazia.
  respondsOnlyOffHours Boolean @default(false) @map("responds_only_off_hours")

  /// O agente se retira da conversa quando um atendente humano entra.
  /// Consumido pelo runtime de mensagem, que ainda nao existe aqui.
  exitOnCollaboratorJoin Boolean @default(false) @map("exit_on_collaborator_join")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  /// `bot_id` e sequencial DENTRO de cada portal do Bitrix: dois clientes tem
  /// bot 5. Um unique global aqui faria a segunda instalacao a criar um bot com
  /// id repetido falhar com erro de constraint sem relacao com a causa.
  @@unique([appId, botId])
  @@index([appId])
  @@map("core_gpt_agents")
}

// ============================================
// ThinkersZap
// ============================================

model Connector {
  id         String            @id @default(uuid())
  appId      String            @map("app_id")
  instanceId String?           @unique @map("instance_id")
  provider   ConnectorProvider @default(ZAPI)
  status     ConnectorStatus   @default(PENDING_SETUP)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  app      App       @relation(fields: [appId], references: [id])
  instance Instance? @relation(fields: [instanceId], references: [id])

  @@index([appId])
  @@map("core_thinkerszap_connectors")
}

model Instance {
  id                String         @id @default(uuid())
  domainId          String         @map("domain_id")
  instanceId        String         @unique @map("instance_id")
  vinculatedChannel String?        @map("vinculated_channel")
  zApiToken         String?        @map("z_api_token")
  // Campos específicos do provider HubMessage (WhatsApp Oficial). Nulos em conectores Z-API.
  channelId         String?        @map("channel_id")
  webhookId         String?        @map("webhook_id")
  wabaId            String?        @map("waba_id")
  phoneId           String?        @map("phone_id")
  /// DEPRECADO por `move-connector-settings-to-spa`: `ConnectorSettings` vive em
  /// `ufCrm93Settings` no item da SPA 1146, que é a fonte única. Nada escreve mais
  /// nesta coluna e nenhum caminho de comportamento a lê — o que sobra é dado
  /// congelado de antes da migração, mantido só até o backfill ser confirmado em
  /// produção. Não voltar a ler daqui: mostraria ao cliente o valor antigo.
  /// O drop é dívida registrada, fora desta change (ver `retire-instance-table`).
  settings          Json           @default("{}") @map("settings")
  status            InstanceStatus @default(DISCONNECTED)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  domain            Domain                    @relation(fields: [domainId], references: [id])
  connector         Connector?
  conversations     Conversation[]
  messages          ThinkzapMessage[]
  widgetOutbox      ThinkzapWidgetOutbox[]
  contactIdentities ThinkzapContactIdentity[]

  @@map("core_thinkerszap_instances")
}

model Conversation {
  id              String   @id @default(uuid())
  instanceId      String
  phoneNumber     String // Número do WhatsApp
  bitrixChatId    String // ID do chat no Bitrix
  bitrixChannelId String // ID do canal no Bitrix
  createdAt       DateTime
  updatedAt       DateTime

  instance Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, phoneNumber])
  @@index([instanceId])
  @@index([bitrixChatId])
  @@map("core_thinkerszap_conversations")
}

model ThinkzapAllowedUser {
  id           String   @id @default(uuid())
  appId        String   @map("app_id")
  bitrixUserId String   @map("bitrix_user_id")
  displayName  String?  @map("display_name")
  email        String?  @map("email")
  permissions  Json     @default("{\"connectors\":{\"read\":true,\"create\":true,\"update\":true,\"delete\":true},\"finance\":{\"read\":false,\"create\":false,\"update\":false,\"delete\":false}}")
  createdAt    DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixUserId])
  @@index([appId])
  @@map("thinkzap_allowed_users")
}

/// Destinatários (por Bitrix user id) do aviso de conexão/desconexão de linha Z-API,
/// um por usuário. Substitui a lista antiga em `app.option` (`NotifyRecipientsService`),
/// que "bugava" com o tempo — tabela relacional não tem parse de JSON pra corromper.
model ThinkzapConnectionNotifyRecipient {
  id           String   @id @default(uuid())
  appId        String   @map("app_id")
  bitrixUserId Int      @map("bitrix_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixUserId])
  @@index([appId])
  @@map("thinkzap_connection_notify_recipients")
}

model ThinkzapAllowedDepartment {
  id                 String   @id @default(uuid())
  appId              String   @map("app_id")
  bitrixDepartmentId String   @map("bitrix_department_id")
  displayName        String?  @map("display_name")
  permissions        Json     @default("{\"connectors\":{\"read\":true,\"create\":true,\"update\":true,\"delete\":true},\"finance\":{\"read\":false,\"create\":false,\"update\":false,\"delete\":false}}")
  createdAt          DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixDepartmentId])
  @@index([appId])
  @@map("thinkzap_allowed_departments")
}

model ThinkzapOperatorOAuth {
  id           String   @id @default(uuid())
  appId        String   @map("app_id")
  bitrixUserId String   @map("bitrix_user_id")
  accessToken  String   @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixUserId])
  @@index([appId])
  @@map("thinkzap_operator_oauth")
}

// ============================================
// ThinkAnalise
// ============================================

model BiAnalyseConnector {
  id            String            @id @default(uuid())
  appId         String            @map("app_id")
  biconnectorId Int               @map("biconnector_id")
  label         String
  provider      BiAnalyseProvider
  apiKey        String            @map("api_key") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@index([appId])
  @@map("core_thinkanalise_connectors")
}

model ThinkAnaliseAuthToken {
  id                   String    @id @default(uuid())
  appId                String    @map("app_id")
  provider             String
  tokenKey             String    @unique @default(uuid()) @map("token_key") @db.Char(36)
  bitrixSourceId       Int?      @unique @map("bitrix_source_id")
  accountId            String?   @map("account_id")
  refreshToken         String    @map("refresh_token") @db.Text
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.Char(64)
  accessToken          String?   @map("access_token") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@index([appId])
  @@map("core_thinkanalise_auth_tokens")
}

model ThinkzapMessage {
  id                String                @id @default(uuid())
  instanceId        String                @map("instance_id")
  source            ThinkzapMessageSource
  providerMessageId String?               @map("provider_message_id")
  bitrixMessageId   String?               @map("bitrix_message_id")
  bitrixChatId      String?               @map("bitrix_chat_id")
  type              ThinkzapMessageType
  text              String?               @db.Text
  fileName          String?               @map("file_name")
  chatId            String?               @map("chat_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, providerMessageId], name: "uq_msg_instance_provider")
  @@unique([instanceId, bitrixMessageId], name: "uq_msg_instance_bitrix")
  /// Substitui o índice simples em `instanceId`: cobre tanto o lookup por
  /// instância (prefixo esquerdo) quanto a contagem por período — sem ele,
  /// `WHERE instance_id IN (...) AND created_at BETWEEN ...` filtra a data sem
  /// índice.
  @@index([instanceId, createdAt])
  @@map("core_thinkerszap_messages")
}

/// Mapa `lid ↔ telefone` de um contato numa linha Z-API.
///
/// **Por que existe.** A Z-API entrega o contato ora pelo telefone, ora pelo `@lid`, no
/// mesmo campo `phone`. Como o Bitrix identifica a sessão do canal aberto pelo `chat.id`,
/// as duas formas viravam dois contatos e duas conversas. A identidade passou a ser o
/// LID, que é o único valor estável — e esta tabela é o que permite chegar nele quando o
/// evento traz telefone e nenhum LID.
///
/// **É cache, não oráculo.** Ela registra pares que aprendeu (de um evento que trouxe os
/// dois, ou de uma consulta a `phone-exists`); ela não deriva nada. `lid` → telefone é
/// impossível por decisão de privacidade do WhatsApp, e nenhum caminho deve fingir que é.
/// Por isso `phone` é nullable: contato que nunca expôs o número tem row com `lid` e sem
/// telefone, para sempre.
///
/// **Escopo é a instância**, e não global: o LID devolvido pela Z-API é o que *aquela*
/// linha enxerga. Que um LID seja o mesmo entre contas diferentes não está documentado —
/// assumir custaria caro e não assumir não custa nada.
model ThinkzapContactIdentity {
  id         String @id @default(uuid())
  instanceId String @map("instance_id")
  lid        String

  /// Telefone normalizado do contato, quando conhecido. `null` = contato lid-only.
  phone String?

  /// A identidade que este contato **já usa** numa sessão de canal aberto criada antes
  /// da mudança para LID.
  ///
  /// Preenchida exclusivamente pelo backfill que roda antes de a resolução por LID ser
  /// ligada. Row com valor aqui usa esse valor como `chat.id` para sempre: trocar a
  /// chave faria o Bitrix abrir uma conversa nova para um contato que já tem uma, e o
  /// `imconnector` não oferece remapear `chat.id`.
  ///
  /// Nada em runtime escreve nesta coluna. Row criada depois do backfill nasce sem ela
  /// e nunca a ganha — é o que impede a regra legada de contaminar contato novo.
  legacyPhoneIdentity String? @map("legacy_phone_identity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, lid], name: "uq_identity_instance_lid")
  @@unique([instanceId, phone], name: "uq_identity_instance_phone")
  @@index([instanceId])
  @@map("core_thinkerszap_contact_identities")
}

/// Intenção de envio pelo widget, gravada **antes** de qualquer chamada ao provider.
///
/// Existe porque enfileirar o envio sem ela transformaria retentativa em mensagem
/// repetida no WhatsApp de quem recebe: sem um registro anterior à chamada, nada
/// distingue "já entreguei e perdi a resposta" de "nunca entreguei". É o
/// `providerMessageId` desta row que responde a pergunta.
///
/// **Não é histórico de conversa.** `ThinkzapMessage` é o histórico; esta tabela é a
/// fila durável, e as duas descrevem a mesma mensagem em fases diferentes da vida.
/// Confundir os papéis é o jeito mais fácil de estragar isso depois.
///
/// Tabela própria e não colunas em `ThinkzapMessage` porque a unique de lá é
/// `(instance_id, provider_message_id)` e o `provider_message_id` **não existe** antes
/// do envio — toda row pré-envio teria a chave nula e colidiria com as outras.
model ThinkzapWidgetOutbox {
  id String @id @default(uuid())

  /// Gerado pela API e devolvido ao widget. Único por instância: é por ele que um
  /// reenvio do próprio front é reconhecido como o mesmo envio.
  clientMessageId String @map("client_message_id")

  instanceId         String @map("instance_id")
  subscriptionItemId String @map("subscription_item_id")
  domainId           String @map("domain_id")
  appCode            String @map("app_code")

  destination String
  /// O texto que o contato lê. Em template é o corpo **resolvido**, não o cru: é ele
  /// que abastece o histórico, o canal aberto e o aviso de falha, e nenhum dos três
  /// tem como substituir `{{1}}` depois.
  text        String @db.Text
  entity      String
  entityId    String @map("entity_id")

  /// O que o worker vai chamar no provider. Mensagem livre e template são a mesma
  /// intenção durável com a mesma garantia de não-duplicidade — o que muda é a
  /// chamada, e é só isso que este campo carrega.
  ///
  /// `@default(TEXT)` para a migration ser aditiva: as rows que já existem são todas
  /// de envio livre.
  kind ThinkzapOutboxKind @default(TEXT)

  /// Os três só existem em `kind = TEMPLATE`, e juntos são o que a Meta precisa para
  /// identificar a versão aprovada e preencher as variáveis. Guardados aqui, e não
  /// derivados de `text`, porque o provider recebe o par (template, parâmetros) — o
  /// corpo resolvido não tem volta.
  templateName       String? @map("template_name")
  templateLanguage   String? @map("template_language")
  templateParameters Json?   @map("template_parameters")
  /// Valores dos botões dinâmicos do template (link com variável e copiar código),
  /// como `{ index, subType, value }[]` — `index` é a posição do botão entre todos
  /// os botões do template. `NULL` em row anterior aos botões: envia sem botão.
  templateButtonParameters Json? @map("template_button_parameters")

  /// Só existe em `kind = INTERACTIVE_BUTTON`: corpo, header/footer opcionais e a
  /// lista de botões, no formato de `InteractiveButtonDescriptor`. Guardado como
  /// veio do chamador — o worker remonta o descriptor direto daqui, sem
  /// recompor a partir de `text`.
  buttonPayload Json? @map("button_payload")

  status ThinkzapOutboxStatus @default(PENDING)

  /// **A marca de entrega.** Nulo = o provider não aceitou nada ainda. Preenchido = já
  /// entreguei, e nenhuma retentativa pode chamar o provider outra vez.
  providerMessageId String? @map("provider_message_id")

  /// Idempotência do comentário de timeline: `crm.timeline.comment.add` não tem chave
  /// de idempotência, então sem este carimbo uma retentativa duplicaria o comentário
  /// no CRM do cliente.
  timelineNotifiedAt DateTime? @map("timeline_notified_at")

  attempts  Int     @default(0)
  lastError String? @map("last_error") @db.Text

  /// O operador do Bitrix24 que clicou em enviar, para o prefixo de nome na entrega.
  ///
  /// Vem do token da requisição: quem escreveu só é conhecido dentro dela, e a
  /// entrega acontece depois, em outro processo. Nulo nas rows gravadas antes desta
  /// coluna — essas entregam sem prefixo.
  operatorBitrixUserId String? @map("operator_bitrix_user_id")

  /// Âncoras do provedor de mensagem do Bitrix, preenchidas **só** no envio vindo de
  /// campanha de SMS. Sem as duas não há como o Bitrix casar o status com a mensagem
  /// da campanha, e é por elas que o worker sabe que aquele envio veio de uma.
  ///
  /// Nulas em envio de widget e de robô — esses não reportam status a lugar nenhum.
  smsSenderCode String? @map("sms_sender_code")

  /// `message_id` do Bitrix, e a **chave de idempotência** da campanha: retentativa do
  /// Bitrix e duplo disparo existem, e a segunda mensagem é visível para o contato —
  /// no HubMessage, cobrada duas vezes.
  /// `@unique` de **campo**, não `@@unique([...], name:)`: um unique nomeado é exposto
  /// pelo nome no `where` do Prisma (`uq_outbox_sms_message: { smsMessageId }`), e a
  /// busca pelo campo cru vira erro só em runtime — o tipo gerado é permissivo demais
  /// para o compilador barrar. O índice no banco é o mesmo
  /// (`core_thinkerszap_widget_outbox_sms_message_id_key`, o nome padrão do Prisma).
  smsMessageId String? @unique @map("sms_message_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sentAt    DateTime? @map("sent_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, clientMessageId], name: "uq_outbox_instance_client")
  /// Serve o alerta de pendência antiga e a limpeza por retenção.
  @@index([status, createdAt])
  @@map("core_thinkerszap_widget_outbox")
}

enum ThinkzapOutboxKind {
  /// Mensagem livre. O worker chama `OutboundMessageSender` com `text`.
  TEXT
  /// Template aprovado do WhatsApp Oficial. O worker chama `TemplateMessageSender`
  /// com `templateName`, `templateLanguage` e `templateParameters`.
  TEMPLATE
  /// Mensagem com botões de ação. O worker chama `InteractiveButtonSender` com o
  /// descriptor gravado em `buttonPayload`.
  INTERACTIVE_BUTTON
}

enum ThinkzapOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  /// O processo morreu **durante** a chamada HTTP ao provider: pode ter entregue ou
  /// não. Não é reenviado automaticamente — reenviar trocaria uma incerteza rara por
  /// duplicidade garantida no WhatsApp de quem recebe.
  UNKNOWN
}

