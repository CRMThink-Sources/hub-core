// ImportSheet
// ============================================

model ImportSheetAuthToken {
  id                   String    @id @default(uuid())
  appId                String    @unique @map("app_id")
  provider             String    @default("google")
  googleSub            String?   @map("google_sub")
  email                String?
  scope                String?   @db.Text
  refreshToken         String    @map("refresh_token") @db.Text
  accessToken          String?   @map("access_token") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@map("core_importsheets_auth_token")
}

model ImportSheetImport {
  id    Int    @id @default(autoincrement())
  appId String @map("app_id")
  title String

  /// { source, target, responsible, options, mappings } — schedule em colunas dedicadas
  config Json @map("config")

  /// Cursor: próxima linha (1-based) a importar. Default 2 = pula o cabeçalho.
  startRow Int @default(2) @map("start_row")

  scheduleMode ImportSheetScheduleMode @default(MANUAL) @map("schedule_mode")
  everyHours   Int?                    @map("every_hours")
  weekdays     Json?                   @map("weekdays")
  nextRunAt    DateTime?               @map("next_run_at")

  enabled       Boolean   @default(true) @map("enabled")
  lastRunAt     DateTime? @map("last_run_at")
  lastRunStatus String?   @map("last_run_status")
  lastError     String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([nextRunAt])
  @@map("core_importsheets_imports")
}

model ClickSignSettings {
  id    String @id @default(uuid())
  appId String @unique @map("app_id")

  fields          Json? @map("fields")
  verifySettings  Json? @map("verify_settings")
  contactSettings Json? @map("contact_settings")
  dealSettings    Json? @map("deal_settings")
  groups          Json? @map("groups")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("core_clicksign_settings")
}

