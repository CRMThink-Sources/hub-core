generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Domain {
  id        String   @id @default(uuid())
  name      String   @unique
  memberId  String   @unique @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apps      App[]
  instances Instance[]
  mcpUsers  McpUser[]

  @@map("core_domains")
}

model AppCode {
  id          String        @id @default(uuid())
  code        String        @unique @map("code")
  name        String
  secret      String        @map("secret")
  description String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  apps        App[]

  @@map("core_app_codes")
}

model App {
  id        String @id @default(uuid())
  domainId  String @map("domain_id")
  appCodeId String @map("app_code_id")
  /// Id do item espelho desta instalacao na SPA 1060 do Bitrix.
  /// `null` = instalacao sem espelho (instalada antes do backfill, ou falha na
  /// criacao do item). Estado valido: so impede criar assinatura, que precisa
  /// do id da SPA no campo parent.
  spaId       String?   @unique @map("spa_id")
  email       String    @map("email")
  status      AppStatus @default(ACTIVE)
  installedAt DateTime  @default(now()) @map("installed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  domain              Domain                @relation(fields: [domainId], references: [id])
  appCode             AppCode               @relation(fields: [appCodeId], references: [id])
  credential          Credential?
  balance             BillingBalance?
  agents              Agent[]
  connectors          Connector[]
  biAnalyseConnectors   BiAnalyseConnector[]
  thinkAnaliseAuthTokens ThinkAnaliseAuthToken[]
  thinkzapAllowedUsers       ThinkzapAllowedUser[]
  thinkzapAllowedDepartments ThinkzapAllowedDepartment[]
  thinkzapOperatorOAuth      ThinkzapOperatorOAuth[]
  importSheetAuthToken       ImportSheetAuthToken?
  importSheetImports         ImportSheetImport[]
  clickSignSettings          ClickSignSettings?

  @@unique([domainId, appCodeId])
  @@index([domainId])
  @@index([appCodeId])
  @@map("core_apps")
}

model Credential {
  id           String   @id @default(uuid())
  appId        String   @unique @map("app_id")
  clientId     String   @map("client_id")
  clientSecret String   @map("client_secret")
  accessToken  String?  @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@map("core_credentials")
}

// ============================================
// BILLING - Créditos (GPT Maker) / Assinatura (ThinkersZap)
// ============================================

/// Saldo de créditos — usado por apps com plano tipo CREDITS (ex: GPT Maker).
model BillingBalance {
  id             Int      @id @default(autoincrement())
  appId          String   @unique @map("app_id")
  currentBalance Int      @default(0) @map("current_balance")
  totalPurchased Int      @default(0) @map("total_purchased")
  totalConsumed  Int      @default(0) @map("total_consumed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  app          App                  @relation(fields: [appId], references: [id])
  transactions BillingTransaction[]

  @@map("billing_balances")
}

model BillingTransaction {
  id           Int             @id @default(autoincrement())
  appId        String          @map("app_id")
  type         TransactionType
  amount       Int
  balanceAfter Int             @map("balance_after")
  description  String
  referenceId  String?         @map("reference_id")
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  balance BillingBalance @relation(fields: [appId], references: [appId])

  @@index([appId])
  @@index([type])
  @@index([createdAt])
  @@map("billing_transactions")
}

// `BillingPlan` e `BillingSubscription` foram removidos junto com a cobrança
// antiga (Stripe + tela de financeiro). A cobrança nova será modelada do zero;
// enquanto isso não existe nenhuma fonte de estado de assinatura no banco.

// ============================================
// GPT MAKER
// ============================================
model Agent {
  id              String @id @default(uuid())
  appId           String @map("app_id")
  gptMakerAgentId String @unique @map("gpt_maker_agent_id")

  app App @relation(fields: [appId], references: [id])

  @@map("core_gpt_agents")
}

// ============================================
// ThinkersZap
// ============================================

model Connector {
  id         String            @id @default(uuid())
  appId      String            @map("app_id")
  instanceId String?           @unique @map("instance_id")
  provider   ConnectorProvider @default(ZAPI)
  status     ConnectorStatus   @default(PENDING_SETUP)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  app      App       @relation(fields: [appId], references: [id])
  instance Instance? @relation(fields: [instanceId], references: [id])

  @@index([appId])
  @@map("core_thinkerszap_connectors")
}

model Instance {
  id                String         @id @default(uuid())
  domainId          String         @map("domain_id")
  instanceId        String         @unique @map("instance_id")
  vinculatedChannel String?        @map("vinculated_channel")
  zApiToken         String?        @map("z_api_token")
  // Campos específicos do provider HubMessage (WhatsApp Oficial). Nulos em conectores Z-API.
  channelId         String?        @map("channel_id")
  webhookId         String?        @map("webhook_id")
  wabaId            String?        @map("waba_id")
  phoneId           String?        @map("phone_id")
  /// DEPRECADO por `move-connector-settings-to-spa`: `ConnectorSettings` vive em
  /// `ufCrm93Settings` no item da SPA 1146, que é a fonte única. Nada escreve mais
  /// nesta coluna e nenhum caminho de comportamento a lê — o que sobra é dado
  /// congelado de antes da migração, mantido só até o backfill ser confirmado em
  /// produção. Não voltar a ler daqui: mostraria ao cliente o valor antigo.
  /// O drop é dívida registrada, fora desta change (ver `retire-instance-table`).
  settings          Json           @default("{}") @map("settings")
  status            InstanceStatus @default(DISCONNECTED)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  domain        Domain               @relation(fields: [domainId], references: [id])
  connector     Connector?
  conversations Conversation[]
  messages      ThinkzapMessage[]

  @@map("core_thinkerszap_instances")
}

model Conversation {
  id              String   @id @default(uuid())
  instanceId      String
  phoneNumber     String // Número do WhatsApp
  bitrixChatId    String // ID do chat no Bitrix
  bitrixChannelId String // ID do canal no Bitrix
  createdAt       DateTime
  updatedAt       DateTime

  instance Instance @relation(fields: [instanceId], references: [id])

  @@unique([instanceId, phoneNumber])
  @@index([instanceId])
  @@index([bitrixChatId])
  @@map("core_thinkerszap_conversations")
}

model ThinkzapAllowedUser {
  id           String   @id @default(uuid())
  appId        String   @map("app_id")
  bitrixUserId String   @map("bitrix_user_id")
  displayName  String?  @map("display_name")
  email        String?  @map("email")
  permissions  Json     @default("{\"connectors\":{\"read\":true,\"create\":true,\"update\":true,\"delete\":true},\"finance\":{\"read\":false,\"create\":false,\"update\":false,\"delete\":false}}")
  createdAt    DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixUserId])
  @@index([appId])
  @@map("thinkzap_allowed_users")
}

model ThinkzapAllowedDepartment {
  id                   String   @id @default(uuid())
  appId                String   @map("app_id")
  bitrixDepartmentId   String   @map("bitrix_department_id")
  displayName          String?  @map("display_name")
  permissions          Json     @default("{\"connectors\":{\"read\":true,\"create\":true,\"update\":true,\"delete\":true},\"finance\":{\"read\":false,\"create\":false,\"update\":false,\"delete\":false}}")
  createdAt            DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixDepartmentId])
  @@index([appId])
  @@map("thinkzap_allowed_departments")
}

model ThinkzapOperatorOAuth {
  id           String   @id @default(uuid())
  appId        String   @map("app_id")
  bitrixUserId String   @map("bitrix_user_id")
  accessToken  String   @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, bitrixUserId])
  @@index([appId])
  @@map("thinkzap_operator_oauth")
}

// ============================================
// ThinkAnalise
// ============================================

model BiAnalyseConnector {
  id            String            @id @default(uuid())
  appId         String            @map("app_id")
  biconnectorId Int               @map("biconnector_id")
  label         String
  provider      BiAnalyseProvider
  apiKey        String            @map("api_key") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@index([appId])
  @@map("core_thinkanalise_connectors")
}

model ThinkAnaliseAuthToken {
  id                   String    @id @default(uuid())
  appId                String    @map("app_id")
  provider             String
  tokenKey             String    @unique @default(uuid()) @map("token_key") @db.Char(36)
  bitrixSourceId       Int?      @unique @map("bitrix_source_id")
  accountId            String?   @map("account_id")
  refreshToken         String    @map("refresh_token") @db.Text
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.Char(64)
  accessToken          String?   @map("access_token") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@index([appId])
  @@map("core_thinkanalise_auth_tokens")
}

model ThinkzapMessage {
  id              String                  @id @default(uuid())
  instanceId      String                  @map("instance_id")
  source            ThinkzapMessageSource
  providerMessageId String?               @map("provider_message_id")
  bitrixMessageId String?                 @map("bitrix_message_id")
  bitrixChatId    String?                 @map("bitrix_chat_id")
  type            ThinkzapMessageType
  text            String?                 @db.Text
  fileName        String?                 @map("file_name")
  chatId                String?                 @map("chat_id")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, providerMessageId], name: "uq_msg_instance_provider")
  @@unique([instanceId, bitrixMessageId], name: "uq_msg_instance_bitrix")
  @@index([instanceId])
  @@map("core_thinkerszap_messages")
}

// ============================================
// ImportSheet
// ============================================

model ImportSheetAuthToken {
  id                   String    @id @default(uuid())
  appId                String    @unique @map("app_id")
  provider             String    @default("google")
  googleSub            String?   @map("google_sub")
  email                String?
  scope                String?   @db.Text
  refreshToken         String    @map("refresh_token") @db.Text
  accessToken          String?   @map("access_token") @db.Text
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  app App @relation(fields: [appId], references: [id])

  @@map("core_importsheets_auth_token")
}

model ImportSheetImport {
  id    Int    @id @default(autoincrement())
  appId String @map("app_id")
  title String

  /// { source, target, responsible, options, mappings } — schedule em colunas dedicadas
  config Json @map("config")

  /// Cursor: próxima linha (1-based) a importar. Default 2 = pula o cabeçalho.
  startRow Int @default(2) @map("start_row")

  scheduleMode ImportSheetScheduleMode @default(MANUAL) @map("schedule_mode")
  everyHours   Int?                    @map("every_hours")
  weekdays     Json?                   @map("weekdays")
  nextRunAt    DateTime?               @map("next_run_at")

  enabled       Boolean   @default(true)  @map("enabled")
  lastRunAt     DateTime?                 @map("last_run_at")
  lastRunStatus String?                   @map("last_run_status")
  lastError     String?   @db.Text        @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([nextRunAt])
  @@map("core_importsheets_imports")
}

model ClickSignSettings {
  id              String   @id @default(uuid())
  appId           String   @unique @map("app_id")

  fields          Json?    @map("fields")
  verifySettings  Json?    @map("verify_settings")
  contactSettings Json?    @map("contact_settings")
  dealSettings    Json?    @map("deal_settings")
  groups          Json?    @map("groups")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("core_clicksign_settings")
}

// ============================================
// ENUMS
// ============================================

enum ImportSheetScheduleMode {
  MANUAL
  HOURS
  DAYS
}

enum AppStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum TransactionType {
  PURCHASE
  CONSUMPTION
  BONUS
  REFUND
  EXPIRATION
}

enum ConnectorProvider {
  ZAPI
  HUBMESSAGE
}

enum ConnectorStatus {
  PENDING_SETUP
  ACTIVE
  INACTIVE
}

enum InstanceStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
}

enum ThinkzapMessageSource {
  ZAPI
  BITRIX
  HUBMESSAGE
}

enum ThinkzapMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  CONTACT
}

enum BiAnalyseProvider {
  ASAAS
  CONTA_AZUL
  OMIE
  SONAX
  BLING
}

enum PortalUserRole {
  ADMIN
}

model PortalUser {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  role         PortalUserRole @default(ADMIN)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("portal_users")
}

// ============================================
// MCP OAUTH — Authorization Server do MCP de suporte
// Base de credencial isolada do portal: acesso ao portal não concede acesso a
// log de cliente. O MCP não fala com o banco; só valida o JWT emitido aqui.
// ============================================

/// Usuário do MCP de suporte. `isAdmin` = suporte interno CRMThink (escolhe
/// qualquer domínio no login); não-admin fica travado no `domainId` do cadastro.
model McpUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  domainId     String   @map("domain_id")
  isAdmin      Boolean  @default(false) @map("is_admin")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  domain        Domain            @relation(fields: [domainId], references: [id])
  authCodes     McpAuthCode[]
  refreshTokens McpRefreshToken[]

  @@index([domainId])
  @@map("core_mcp_users")
}

/// Client registrado via Dynamic Client Registration (RFC 7591) pelo claude.ai.
/// Public client: `token_endpoint_auth_method="none"`, sem secret — PKCE é a prova.
model McpOauthClient {
  id                      String   @id @default(uuid())
  clientId                String   @unique @map("client_id")
  clientName              String?  @map("client_name")
  redirectUris            Json     @map("redirect_uris")
  grantTypes              Json     @map("grant_types")
  responseTypes           Json     @map("response_types")
  scope                   String?
  tokenEndpointAuthMethod String   @default("none") @map("token_endpoint_auth_method")
  clientUri               String?  @map("client_uri")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  authCodes     McpAuthCode[]
  refreshTokens McpRefreshToken[]

  @@map("core_mcp_oauth_clients")
}

/// Authorization code de uso único (TTL ~60s). Guarda o `domainId` escolhido na
/// tela de login — é ele que vira o claim `domain` do access token.
model McpAuthCode {
  id                  String    @id @default(uuid())
  code                String    @unique
  userId              String    @map("user_id")
  clientId            String    @map("client_id")
  domainId            String    @map("domain_id")
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  redirectUri         String    @map("redirect_uri") @db.Text
  resource            String?   @db.Text
  scopes              Json
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user   McpUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client McpOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
  @@map("core_mcp_auth_codes")
}

/// Refresh token opaco, persistido só como hash. Rotação de uso único: o
/// `/token` revoga o atual e aponta `rotatedToId` pro novo. Reuso de um token já
/// rotacionado = sinal de vazamento → revogar a cadeia inteira.
model McpRefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id")
  clientId    String    @map("client_id")
  domainId    String    @map("domain_id")
  scopes      Json
  resource    String?   @db.Text
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  rotatedToId String?   @map("rotated_to_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user   McpUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client McpOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
  @@map("core_mcp_refresh_tokens")
}
