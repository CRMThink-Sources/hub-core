// ============================================
// EXPIRAÇÃO DE ASSINATURAS — histórico das rodadas da varredura
// Uma linha por rodada (agendada ou manual), mesmo sem alteração, e uma por
// assinatura alterada ou com falha. Guardado por 90 dias.
// ============================================

enum SubscriptionExpirationTrigger {
  SCHEDULED
  MANUAL
}

/// `RUNNING` órfão (processo morto) não é gravado como abandonado: é derivado na
/// leitura pela idade de `startedAt`.
enum SubscriptionExpirationRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model SubscriptionExpirationRun {
  id                      String                          @id @default(uuid())
  trigger                 SubscriptionExpirationTrigger
  triggeredByPortalUserId String?                         @map("triggered_by_portal_user_id")
  status                  SubscriptionExpirationRunStatus @default(RUNNING)
  startedAt               DateTime                        @default(now()) @map("started_at")
  finishedAt              DateTime?                       @map("finished_at")
  checked                 Int                             @default(0)
  trialExpired            Int                             @default(0) @map("trial_expired")
  pastDue                 Int                             @default(0) @map("past_due")
  failed                  Int                             @default(0)
  paused                  Boolean                         @default(false)
  error                   String?                         @db.Text

  triggeredBy PortalUser?                    @relation(fields: [triggeredByPortalUserId], references: [id], onDelete: SetNull)
  changes     SubscriptionExpirationChange[]

  @@index([startedAt])
  @@index([triggeredByPortalUserId])
  @@map("core_subscription_expiration_runs")
}

/// Status em texto, não enum: são valores do domínio da SPA, e um status novo
/// não deve exigir migration.
model SubscriptionExpirationChange {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  subscriptionId String   @map("subscription_id")
  fromStatus     String   @map("from_status")
  toStatus       String   @map("to_status")
  periodEnd      DateTime @map("period_end")
  succeeded      Boolean
  error          String?  @db.Text

  run SubscriptionExpirationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("core_subscription_expiration_changes")
}

// ============================================
// MCP OAUTH — Authorization Server do MCP de suporte
// Base de credencial isolada do portal: acesso ao portal não concede acesso a
// log de cliente. O MCP não fala com o banco; só valida o JWT emitido aqui.
// ============================================

/// Usuário do MCP de suporte. `isAdmin` = suporte interno CRMThink (escolhe
/// qualquer domínio no login); não-admin fica travado no `domainId` do cadastro.
model McpUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  domainId     String   @map("domain_id")
  isAdmin      Boolean  @default(false) @map("is_admin")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  domain        Domain            @relation(fields: [domainId], references: [id])
  authCodes     McpAuthCode[]
  refreshTokens McpRefreshToken[]

  @@index([domainId])
  @@map("core_mcp_users")
}

/// Client registrado via Dynamic Client Registration (RFC 7591) pelo claude.ai.
/// Public client: `token_endpoint_auth_method="none"`, sem secret — PKCE é a prova.
model McpOauthClient {
  id                      String   @id @default(uuid())
  clientId                String   @unique @map("client_id")
  clientName              String?  @map("client_name")
  redirectUris            Json     @map("redirect_uris")
  grantTypes              Json     @map("grant_types")
  responseTypes           Json     @map("response_types")
  scope                   String?
  tokenEndpointAuthMethod String   @default("none") @map("token_endpoint_auth_method")
  clientUri               String?  @map("client_uri")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  authCodes     McpAuthCode[]
  refreshTokens McpRefreshToken[]

  @@map("core_mcp_oauth_clients")
}

/// Authorization code de uso único (TTL ~60s). Guarda o `domainId` escolhido na
/// tela de login — é ele que vira o claim `domain` do access token.
model McpAuthCode {
  id                  String    @id @default(uuid())
  code                String    @unique
  userId              String    @map("user_id")
  clientId            String    @map("client_id")
  domainId            String    @map("domain_id")
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  redirectUri         String    @map("redirect_uri") @db.Text
  resource            String?   @db.Text
  scopes              Json
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user   McpUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client McpOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
  @@map("core_mcp_auth_codes")
}

/// Refresh token opaco, persistido só como hash. Rotação de uso único: o
/// `/token` revoga o atual e aponta `rotatedToId` pro novo. Reuso de um token já
/// rotacionado = sinal de vazamento → revogar a cadeia inteira.
model McpRefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id")
  clientId    String    @map("client_id")
  domainId    String    @map("domain_id")
  scopes      Json
  resource    String?   @db.Text
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  rotatedToId String?   @map("rotated_to_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user   McpUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client McpOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
  @@map("core_mcp_refresh_tokens")
}

// ============================================
// ThinkZap — gerador de bot (fluxo de atendimento)
// ============================================

/// Bot de canal aberto de um fluxo, registrado por `imbot.v2.Bot.register`.
///
/// Tabela e nao cache em Redis: `botToken` sai **uma vez** no registro e
/// `imbot.v2.Bot.list` nao o repete. Sem ele `transfer` e `finish` nao identificam o bot.
model ThinkzapBotFlowBot {
  id    String @id @default(uuid())
  appId String @map("app_id")
  /// `SetNull` e nao `Cascade`: se o portal recusar o `unregister`, o token e a unica
  /// forma de alcancar o bot que ficou la.
  flowId String? @unique @map("flow_id")
  /// `id` do bot no portal, usado em `WELCOME_BOT_ID`.
  bitrixBotId Int @map("bitrix_bot_id")
  /// `CLIENT_ID` de `bot.session.transfer` / `.finish`. Obrigatorio: bot e webhook.
  botToken String @map("bot_token") @db.Text
  /// Handler registrado. Trocar de URL exige `Bot.update` — sem isto o portal segue
  /// batendo no endereco antigo e nenhum evento chega.
  webhookUrl String   @map("webhook_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  app  App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  flow ThinkzapBotFlow? @relation(fields: [flowId], references: [id], onDelete: SetNull)

  /// `bot.id` do evento resolve o bot; o id e sequencial por portal, nao global.
  @@unique([appId, bitrixBotId])
  @@index([appId])
  @@map("thinkzap_bot_flow_bots")
}

model ThinkzapBotFlow {
  id     String                @id @default(uuid())
  appId  String                @map("app_id")
  name   String
  status ThinkzapBotFlowStatus @default(DRAFT)
  /// Sobe a cada publicacao. A sessao guarda a versao com que comecou.
  version Int      @default(1)
  /// `{ entryNodeId, nodes[], settings }` — validado por `bot-flow/flow.schema.ts`.
  graph   Json
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  app      App                      @relation(fields: [appId], references: [id], onDelete: Cascade)
  bindings ThinkzapBotFlowBinding[]
  sessions ThinkzapBotSession[]
  bot      ThinkzapBotFlowBot?

  @@unique([appId, name])
  @@index([appId])
  @@map("thinkzap_bot_flows")
}

model ThinkzapBotFlowBinding {
  id     String @id @default(uuid())
  appId  String @map("app_id")
  flowId String @map("flow_id")
  /// `CONFIG_ID` da linha (canal aberto) no Bitrix.
  lineId String @map("line_id")
  /// Reservado. Um fluxo por canal (ver @@unique), entao nao ha o que ordenar.
  priority Int     @default(100)
  active   Boolean @default(true)
  /// Reservado, junto com `priority`: sem dois fluxos por canal, nao ha o que desempatar.
  condition Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app  App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  flow ThinkzapBotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  /// Canal aberto ocupado nao aceita outro fluxo. O Bitrix so guarda um
  /// `WELCOME_BOT_ID` por linha, entao dois vinculos na mesma linha nao seriam
  /// representaveis no portal — o segundo sobrescreveria o primeiro em silencio.
  @@unique([appId, lineId])
  @@index([appId, lineId, priority])
  @@index([flowId])
  @@map("thinkzap_bot_flow_bindings")
}

model ThinkzapBotSession {
  id           String @id @default(uuid())
  appId        String @map("app_id")
  bitrixChatId String @map("bitrix_chat_id")
  flowId       String @map("flow_id")
  flowVersion  Int    @map("flow_version")
  /// Snapshot do graph publicado no inicio: publicar nao quebra conversa em curso.
  graph Json
  /// Snapshot do contexto da linha (provider, settings, canal aberto). Evita reler
  /// assinatura no CRM a cada mensagem — leitura que consome `operating` do app.
  lineSnapshot Json    @map("line_snapshot")
  /// Qual vinculo casou. Sem isso, condicao errada e invisivel na apuracao.
  bindingId     String? @map("binding_id")
  currentNodeId String  @map("current_node_id")
  vars          Json
  /// Tentativas no no atual.
  attempts Int                      @default(0)
  status   ThinkzapBotSessionStatus @default(ACTIVE)
  closedAt DateTime?                @map("closed_at")
  /// Sessao abandonada nao fica presa: passado o prazo, a proxima mensagem comeca de novo.
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  app  App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  flow ThinkzapBotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  /// MySQL nao tem unique parcial: "uma sessao ativa por chat" e garantida pelo lock
  /// por `bitrixChatId` no worker, nao por constraint.
  @@index([appId, bitrixChatId, status])
  @@index([flowId])
  @@map("thinkzap_bot_sessions")
}

enum ThinkzapBotFlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ThinkzapBotSessionStatus {
  ACTIVE
  HANDED_OFF
  FINISHED
  ABORTED
  EXPIRED
}
