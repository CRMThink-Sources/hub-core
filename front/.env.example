API_URL=http://localhost:4001

# Em dev, next.config rewrites encaminham /api/* para API_URL (tunel unico no :3000 para Bitrix)
NEXT_PUBLIC_API_URL=http://localhost:4001/api
NEXTAUTH_URL=http://localhost:4001
NEXTAUTH_SECRET=secret

JWT_SECRET=secret

# Base dos links para as LPs (botao "Abrir manual" das telas de Ajuda).
NEXT_PUBLIC_APP_URL=http://localhost:3001

NEXT_PUBLIC_THINKZAP_APP_CODE=thinkzap_app_code

# Public Key do SDK @hubmessage/connect (WhatsApp Oficial). Pode ser exposta no frontend.
NEXT_PUBLIC_HUBMESSAGE_PUBLIC_KEY=hubmessage_public_key

# NEXT_PUBLIC_* sao inlinados no build: trocar valor exige rebuildar a imagem.

# Conectores contrataveis (ZAPI, HUBMESSAGE). Vazio = so ZAPI.
NEXT_PUBLIC_THINKZAP_ENABLED_PROVIDERS=ZAPI

# Menu do ThinkBot no thinkzap. So some com 'false'.
NEXT_PUBLIC_THINKZAP_THINKBOT_MENU_ENABLED=true

# Botoes "Instalar no Bitrix24" (URL do Market) e "Falar no WhatsApp" (com DDI) das LPs. Vazio esconde o botao.
NEXT_PUBLIC_THINKZAP_MARKET_URL=
NEXT_PUBLIC_THINKZAP_SALES_WHATSAPP=
NEXT_PUBLIC_IMPORTSHEET_MARKET_URL=
NEXT_PUBLIC_IMPORTSHEET_SALES_WHATSAPP=
NEXT_PUBLIC_CLICKSIGN_MARKET_URL=
NEXT_PUBLIC_CLICKSIGN_SALES_WHATSAPP=
